# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# Which AI brain: mock (no AI, rules only) | gemini | bedrock
LLM_PROVIDER=mock

# Google Gemini (free key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AWS Bedrock (AWS sponsor prize) - needs AWS credentials configured (aws configure)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# ElevenLabs voice (ElevenLabs sponsor prize)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
